# Copy this file to .env and adjust. Every variable is optional: the values
# below are the defaults used when a variable is absent.

# SQLite database file (created at startup, parent folder included).
DATABASE_URL=sqlite:///./data/portfolio.db

# Price source: "yahoo" (live, through yfinance) or "mock" (deterministic, offline).
PRICE_PROVIDER=yahoo

# FX source: "auto", "frankfurter" (ECB reference rates), "yahoo" or "mock".
# "auto" = frankfurter with a Yahoo fallback, or mock when PRICE_PROVIDER=mock.
FX_PROVIDER=auto

# Base URL of the Frankfurter API (ECB data). Change it to use a self-hosted instance.
FRANKFURTER_BASE_URL=https://api.frankfurter.dev/v1

# Timeout of every outgoing HTTP request, in seconds.
HTTP_TIMEOUT_SECONDS=5

# On-demand refresh ("Actualiser" button, page load) skips anything fetched
# more recently than this.
PRICE_TTL_MINUTES=15

# A price older than this gets a "périmé" (stale) badge.
STALE_AFTER_HOURS=24

# Period of the in-process background refresh, in hours. 0 disables it.
BACKGROUND_REFRESH_HOURS=6

# Time zone used to display timestamps and to decide what "today" is.
DISPLAY_TIMEZONE=Europe/Amsterdam

# Host names the app answers to (protection against DNS rebinding).
# Add a name here only if you reach the app through another host name.
ALLOWED_HOSTS=127.0.0.1,localhost
